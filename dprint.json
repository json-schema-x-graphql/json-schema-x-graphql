{
  "graphql": {
    "indentWidth": 2,
    "useTabs": false
  },
  "includes": [
    "schema/**/*.graphql",
    "examples/**/*.graphql"
  ],
  "excludes": [
    "**/node_modules",
    "**/target",
    "**/dist",
    "**/.git"
  ],
  "plugins": [
    "https://plugins.dprint.dev/g-plane/pretty_graphql-v0.2.1.wasm"
  ]
}
